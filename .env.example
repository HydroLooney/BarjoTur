# BarjoTur — variables d'environnement (exemple). Jamais de secret réel ici : copier vers .env (gitignoré).

# DB1 — norvege_routing (Mac M2, PostGIS local sur USB, le worker calcule). Accès trust en dev.
DB1_HOST=127.0.0.1
DB1_PORT=5433
DB1_NAME=norvege_routing
DB1_USER=postgres
DB1_PASSWORD=

# DB2 — norvege_v2 (Bomp4rd, PostGIS 17 + pgRouting, autonome au runtime, le backend sert).
DB2_HOST=127.0.0.1
DB2_PORT=5432
DB2_NAME=norvege_v2
DB2_USER=barjotur
DB2_PASSWORD=

# BFF Node (Express)
SERVER_PORT=3040
NODE_ENV=development

# Sidecar Python (OR-Tools) — composition orienteering
SIDECAR_URL=http://127.0.0.1:8090

# Martin — tuiles vectorielles MVT
MARTIN_URL=http://127.0.0.1:3000
